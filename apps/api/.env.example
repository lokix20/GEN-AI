# Server
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# Database
# Local Docker Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/haritha_sahayak
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/haritha_sahayak
# Or Supabase (use the pooled URI for DATABASE_URL, the direct port-5432 URI for DIRECT_URL):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Redis (optional in dev — falls back to in-memory if unreachable)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AI providers (optional — leave unset to use the built-in mock provider)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage (optional — leave unset to use local-disk storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Notifications (optional — leave unset to log OTP/reset codes to the console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Google login (optional — frontend button is hidden until this + VITE_GOOGLE_CLIENT_ID are set)
GOOGLE_CLIENT_ID=
